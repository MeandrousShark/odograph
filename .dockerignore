# Keep the build context small and exclude local secrets. Only the runtime
# account setup functions from scripts/ are needed in the image.
.env*
!.env.example

.git
.venv
tests/
docs/
.claude/
.codex/
__pycache__/
*.pyc
.pytest_cache/
compose.yaml
scripts/*
!scripts/sql/
scripts/sql/*
!scripts/sql/account_bootstrap.sql
!scripts/sql/account_admission.sql
!scripts/sql/tracking_admission.sql
!scripts/sql/member_invitations.sql
!scripts/sql/oidc_attempts.sql
!scripts/sql/oidc_methods.sql
!scripts/sql/account_lifecycle.sql
.pgdump/
backups/

# OS junk
.DS_Store
