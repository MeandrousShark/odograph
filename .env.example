# Run scripts/generate_env.sh to create .env with safe generated secrets.
# For manual generation, POSTGRES_PASSWORD must be URI-safe because compose
# embeds it in DATABASE_URL (for example: openssl rand -hex 32).

POSTGRES_PASSWORD=

# OwnTracks HTTP-mode credentials (username defaults to "owntracks")
INGEST_PASSWORD=

# Signs the UI session cookie
SESSION_SECRET=

# Gates the one-time /setup page for creating the local admin account (or
# resetting its password). Consumed on use — a token that has successfully
# created or reset the admin is refused thereafter, so recovery means
# putting a fresh value here and recreating the app container so it loads
# the changed environment. Unset makes /setup 404.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Optional OIDC client. Leave all three variables unset for local-only
# authentication. If enabled, set all three together and register callback
# URL https://mileage.example.com/auth/callback with the provider.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Empty/unset lets any OIDC-authenticated account in (fine if the provider
# has only one user). Set this to reject login for every other email. This
# app has no per-user data isolation, so a second account would see
# everyone's trips.
# ALLOWED_EMAIL=you@example.com

# Timestamps are stored UTC; this controls rendering, month grouping,
# and manual-entry interpretation. Use an IANA name from:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DISPLAY_TZ=America/New_York

# Detector parameters — defaults shown, uncomment to override.
# STAY_RADIUS_M=150
# STAY_MIN_DURATION_S=300
# WALK_MAX_SPEED_MS=2.0     # on-foot stay ceiling; raise if hikes still bundle
# MIN_TRIP_DISTANCE_M=300
# MAX_ACCURACY_M=100
# MAX_SPEED_MS=60
# GAP_FLAG_THRESHOLD_S=600
# DETECT_DEBOUNCE_S=60
# DETECT_SWEEP_S=900
# FULL_REPROCESS_WARN_POINTS=500000

# Trip rows loaded per month before an htmx "Load more" control appears.
# TRIPS_PAGE_SIZE=25

# Ingest brute-force limiter
# INGEST_AUTH_MAX_FAILURES=10
# INGEST_AUTH_WINDOW_S=900

# Local-login and setup-token brute-force limiter
# LOGIN_AUTH_MAX_FAILURES=10
# LOGIN_AUTH_WINDOW_S=900

# Oversized /ingest bodies are dropped (200, logged) rather than stored —
# real OwnTracks payloads are tiny.
# INGEST_MAX_BODY_BYTES=65536

# Uvicorn accepts forwarded client/scheme headers only from these peers,
# and both failed-auth rate limiters key off the client address this
# produces. `*` is safe ONLY because the canonical compose file binds the
# app port to host loopback behind a trusted reverse proxy -- with that
# binding, the proxy is the only peer Uvicorn ever sees. If you publish
# this port directly, or point a proxy at anything other than that
# loopback-bound container, `*` lets a client spoof X-Forwarded-For and
# dodge both limiters; replace this with the exact IP/CIDR of your proxy's
# egress instead -- see docs/reverse-proxy.md before exposing the port.
FORWARDED_ALLOW_IPS=*

# This app never terminates TLS itself, so it can't emit HSTS safely by
# default -- get it from your reverse proxy instead (see docs/reverse-proxy.md).
# Set this only if your proxy won't add the header itself; it is only ever
# sent on a request the app already sees as HTTPS.
# HSTS_MAX_AGE=63072000

# Map tiles shown on the trip detail/review maps, and the attribution shown
# alongside them. The CSP's img-src is derived from this host, so changing
# the provider here is enough -- no other file needs to agree with it.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Road-snapping — empty/unset disables it entirely; the app runs fully
# fine without it. Only set this after the one-time OSRM data prep is done
# (osrm-extract, osrm-partition, osrm-customize against a road extract) and
# the `osrm` compose service is up.
# OSRM_URL=http://osrm:5000
# OSRM_MIN_CONFIDENCE=0.5
# OSRM_MAX_COORDS=250
# SNAP_DEBOUNCE_S=15
# SNAP_SWEEP_S=300

# Dataset filename the `osrm` compose service serves from /data. Left
# commented out on purpose -- there's no region every operator wants, and
# an uncommented default here would silently inherit the maintainer's own
# extract. Set this to the value scripts/provision_osrm.sh prints after
# provisioning your own region's extract; see docs/osrm.md.
# OSRM_DATASET=florida-latest.osrm

# Reverse geocoding + address search — no provider configured disables the
# geocode worker and /places/search entirely; the app runs fully fine
# without it. GEOCODE_PROVIDER selects which service receives your trip
# coordinates: "geoapify" (hosted, needs GEOCODE_API_KEY) or "nominatim"
# (self-hosted only). Left unset with GEOCODE_API_KEY set, it resolves to
# geoapify for compatibility with configs from before this setting existed.
# GEOCODE_PROVIDER=geoapify
# Sign up at https://www.geoapify.com/ for a free-tier key (one key covers
# both the Reverse Geocoding and Autocomplete APIs).
# GEOCODE_API_KEY=
# GEOCODE_NOMINATIM_URL points GEOCODE_PROVIDER=nominatim at your own
# self-hosted Nominatim instance -- it has no default, and none is shipped
# on purpose. nominatim.openstreetmap.org, the public instance, forbids
# exactly the kind of bulk automated lookup this app does under its usage
# policy; pointing this variable at it anyway is your own decision and your
# own policy responsibility to keep, not something this app endorses or
# defaults to. The intended deployment is a Nominatim you run yourself.
# GEOCODE_NOMINATIM_URL=
# GEOCODE_MIN_INTERVAL_S=1.0
# GEOCODE_DEBOUNCE_S=15
# GEOCODE_SWEEP_S=300
# Trailing country suffix stripped from every returned address (comma-
# separated from the rest of the label); empty disables stripping. Defaults
# to the US suffix since deductions here are IRS mileage rates -- set empty
# if you drive cross-border and want the country kept.
# GEOCODE_OMIT_COUNTRY=United States of America

# Weekly unclassified-trip reminder — set both ntfy values to enable.
# The message contains only a count and, if APP_URL is set, a link to the
# matching unclassified-trip filter. It runs Sunday at 18:00 in DISPLAY_TZ.
# NTFY_URL=https://ntfy.example.com
# NTFY_TOPIC=mileage-reminders
# Use a bearer token or an ntfy username/password. When both are set, Basic
# auth takes precedence, matching services that use ntfy's account auth.
# NTFY_TOKEN=
# NTFY_USERNAME=
# NTFY_PASSWORD=
# Public HTTPS URL used in reminder links. It does not configure TLS or
# the reverse proxy; leave unset unless reminders are enabled.
# APP_URL=https://mileage.example.com
# NUDGE_WEEKLY_HOUR=18

# Quarterly odometer-reading reminder — reuses the ntfy values above;
# no separate ntfy config. Defaults ON whenever NTFY_URL/NTFY_TOPIC are
# set; set ODOMETER_REMINDER=0 to disable it independently of the weekly
# nudge. Fires the first day of each calendar quarter at this hour in
# DISPLAY_TZ, and only for an active vehicle with no reading logged yet
# that quarter.
# ODOMETER_REMINDER=1
# ODOMETER_REMINDER_HOUR=9

# Outbound email — set SMTP_HOST, EMAIL_FROM, and EMAIL_TO to enable;
# the app runs fully fine without it (no worker starts, ntfy is unaffected).
# Powers a monthly business-miles/deduction summary and a year-end filing
# reminder (both default on once email is configured), plus opt-in email
# twins of the weekly unclassified-trip nudge and the quarterly odometer
# reminder above (ntfy already covers both, so their email channels default
# off to avoid a duplicate ping).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls          # starttls | ssl | none (LAN relay)
# Skip certificate verification -- only for a localhost bridge with a
# self-signed cert (e.g. Proton Mail Bridge). Never set this against a
# real relay over the network.
# SMTP_TLS_INSECURE=0
# EMAIL_FROM=odograph@example.com
# EMAIL_TO=you@example.com
# EMAIL_WEEKLY_NUDGE=0
# EMAIL_MONTHLY_SUMMARY=1
# EMAIL_FILING_REMINDER=1
# EMAIL_ODOMETER_REMINDER=0
# EMAIL_DIGEST_HOUR=9
# EMAIL_FILING_REMINDER_MMDD=01-15

# Missing-trip detection — flags a suspicious spatial gap between one
# detected trip's end and the next detected trip's start on the same device
# (phone stopped reporting mid-drive), with a one-click prefilled bridging
# manual trip. Distance-only threshold in meters; 0 disables the feature.
# MISSING_TRIP_GAP_M=1000

# Local development ONLY — disables UI auth entirely. Never set in production.
# DEV_NO_AUTH=1
