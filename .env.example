# Run scripts/generate_env.sh to create .env. It fills every blank secret
# below and refuses to overwrite an existing file. The complete option
# reference is docs/configuration.md.

# Database credential used by the canonical Compose stack. Keep it URI-safe.
POSTGRES_PASSWORD=

# OwnTracks HTTP-mode credential. The username defaults to "owntracks".
INGEST_PASSWORD=

# Signs browser session cookies.
SESSION_SECRET=

# A fresh install permits creation of its sole administrator in the browser.
# The first account row closes signup permanently, even if this remains 1.
INITIAL_ADMIN_SIGNUP=1

# IANA timezone for display, reports, and manual trip entry.
DISPLAY_TZ=America/New_York

# Safe for the shipped loopback-only port binding. If the app port or reverse
# proxy topology changes, narrow this as described in docs/reverse-proxy.md.
FORWARDED_ALLOW_IPS=*
