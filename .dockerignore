# Keep the build context small and exclude local secrets. Only the three
# account setup functions from scripts/ are needed in the runtime image.
.env*
!.env.example

.git
.venv
tests/
docs/
.claude/
.codex/
__pycache__/
*.pyc
.pytest_cache/
compose.yaml
scripts/*
!scripts/sql/
scripts/sql/*
!scripts/sql/account_bootstrap.sql
!scripts/sql/account_admission.sql
!scripts/sql/tracking_admission.sql
.pgdump/
backups/

# OS junk
.DS_Store
